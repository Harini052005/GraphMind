# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# FalkorDB Cloud Configuration
# Format: redis://[username]:[password]@[host]:[port]
# Example: redis://default:your_secret_password@db.falkordb.cloud:12345
FALKORDB_URL=redis://localhost:6379
FALKORDB_GRAPH=leetcode_mastery

# LLM Configuration (Optional: Deterministic fallback activates if key is unset)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
